# Database
DATABASE_URL=postgresql://postgres@docker-services-postgres-1:5432/finforge

# API Security
API_KEY=

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ACCOUNTS=WF Checking,WF Credit Card,Amex Credit Card
PLAID_WF_CHECKING_ACCESS_TOKEN=
PLAID_WF_CREDIT_CARD_ACCESS_TOKEN=
PLAID_AMEX_CREDIT_CARD_ACCESS_TOKEN=
PLAID_CURSOR_FILE=/secrets/plaid_cursors.json

# Schwab API
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
SCHWAB_TOKEN_FILE=/secrets/schwab_tokens.json
SCHWAB_ACCOUNT_MAP=

# JWT Auth
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# Squawk sign-in (the only way into the UI; empty SQUAWK_ISSUER = disabled)
SQUAWK_ISSUER=
SQUAWK_SERVICE_ID=
SQUAWK_CREDENTIAL=
SQUAWK_CLIENT_ID=
SQUAWK_RESOURCE=https://finforge.nathanblatter.com/api
SQUAWK_OWNER_USERNAME=nathan

# Cloudflare Tunnel
TUNNEL_TOKEN=

# Claude AI
ANTHROPIC_API_KEY=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Outbound email recipients (repo is public; never hardcode these)
REPORT_TO_EMAIL=
REIMBURSEMENT_TO_EMAIL=
